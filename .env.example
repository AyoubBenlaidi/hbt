# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Database (Drizzle). `neon env pull` writes these to .env.local for the checked-out branch
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct connection, for drizzle-kit migrations and pg_dump
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Auth (Better Auth, self-hosted). Secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change_me_32_chars_minimum
BETTER_AUTH_URL=http://localhost:3000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Monthly report (Vercel Cron)
CRON_SECRET=a_long_random_string

# SMTP (e.g. Gmail with an app password: smtp.gmail.com / 465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_address@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM="Home Budget <your_address@gmail.com>"
