# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/hbt

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Monthly report (Vercel Cron)
CRON_SECRET=a_long_random_string

# SMTP (e.g. Gmail with an app password: smtp.gmail.com / 465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_address@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM="Home Budget <your_address@gmail.com>"
