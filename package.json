{
  "name": "home-budget-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "dotenv -e .env.local drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local drizzle-kit migrate",
    "db:studio": "dotenv -e .env.local drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migration:compare": "tsx scripts/migration/compare-databases.ts",
    "migration:import-auth": "tsx scripts/migration/import-supabase-auth.ts"
  },
  "dependencies": {
    "@neon/config": "^1.14.5",
    "@neon/env": "^2.1.8",
    "@supabase/supabase-js": "^2.43.0",
    "@vercel/functions": "^3.11.3",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.352.0",
    "next": "^15.0.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.11.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.2.2",
    "tailwindcss": "^3.4.1",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
